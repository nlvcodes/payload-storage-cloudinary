{
  "name": "payload-storage-cloudinary",
  "version": "2.0.0",
  "description": "Cloudinary storage adapter for Payload CMS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./helpers/*": {
      "import": "./dist/helpers/*.js",
      "types": "./dist/helpers/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:types && pnpm build:swc && pnpm build:copy",
    "build:swc": "swc src -d dist --strip-leading-paths --ignore \"**/*.test.ts,**/*.spec.ts,**/__tests__/**\"",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:copy": "copyfiles -u 1 \"src/**/*.{scss,css}\" dist",
    "dev": "pnpm build:swc --watch",
    "clean": "rm -rf dist",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "smoke:live": "pnpm build && node scripts/live-smoke-test/index.mjs"
  },
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "payload-plugin",
    "payload-storage",
    "cloudinary",
    "storage",
    "upload",
    "media"
  ],
  "author": "Nick Vogel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick-vogel/payload-storage-cloudinary.git"
  },
  "bugs": {
    "url": "https://github.com/nick-vogel/payload-storage-cloudinary/issues"
  },
  "homepage": "https://github.com/nick-vogel/payload-storage-cloudinary#readme",
  "peerDependencies": {
    "@payloadcms/ui": "^4.0.0-beta.0",
    "payload": "^4.0.0-beta.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.3",
    "cloudinary": "^2.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.3.96",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "payload": "4.0.0-beta.3",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
